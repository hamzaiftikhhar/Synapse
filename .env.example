# PostgreSQL 18 + pgvector (Homebrew / local)
# Copy to .env and adjust for your local Postgres.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Staff JWT (portal)
# JWT_SECRET_KEY=  # defaults to SECRET_KEY
JWT_STAFF_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_STAFF_REFRESH_TOKEN_EXPIRE_DAYS=14

# Patient JWT (widget OTP)
JWT_PATIENT_ACCESS_TOKEN_EXPIRE_MINUTES=120
OTP_EXPIRE_MINUTES=10
OTP_CODE_LENGTH=6

# Twilio (optional in local — OTP debug_code returned when unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Paddle Billing (optional in local — billing endpoints 503 when unset)
# Sandbox keys from Paddle > Developer Tools > Authentication.
PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=paddle_sandbox_api_key
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=Token
# PADDLE_WEBHOOK_SECRET=paddle_sandbox_Webhook_secret

# Knowledge pipeline
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
# Phase 3: embed + index on upload (set False for chunk-only debugging)
KNOWLEDGE_RUN_EMBEDDINGS=True

# Embeddings — see docs/rag/EMBEDDING-PROVIDER-SWITCH.md
# Local (free, while OpenAI billing unavailable):
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
#
# OpenAI (later, when credits work):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=

# Intent & Entity NLU — OpenAI primary (nano); Gemini secondary when AIza key exists
NLU_PROVIDER=openai
NLU_MODEL=gpt-4.1-nano
NLU_FALLBACK_MODEL=gpt-4.1-mini
NLU_SECONDARY_PROVIDER=gemini
# GOOGLE_API_KEY=  # must start with AIza from https://aistudio.google.com/apikey
NLU_API_TIMEOUT_SECONDS=3.5
NLU_CONFIDENCE_THRESHOLD=0.75
NLU_ENABLE_RULES=True
NLU_RULES_BEFORE_LLM=False
NLU_FALLBACK_OPENAI=True
NLU_FALLBACK_ON_TIMEOUT=True
OPENAI_API_KEY=
#
# Final answer synthesis — OpenAI primary with hard deadlines
CHAT_RESPONSE_PROVIDER=openai
CHAT_RESPONSE_MODEL=gpt-4.1-mini
CHAT_RESPONSE_SECONDARY_PROVIDER=gemini
CHAT_RESPONSE_FALLBACK_MODELS=
CHAT_RESPONSE_TIMEOUT_SECONDS=8
CHAT_REQUEST_BUDGET_SECONDS=20
CHAT_RESPONSE_MIN_REMAINING_SECONDS=2
CHAT_RESPONSE_STREAMING=False
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=600
CLINIC_FACT_CACHE_TTL_SECONDS=600
#
# AI pipeline debugger
# DEBUG_CHAT_PIPELINE=true
# DEBUG_CHAT_PIPELINE_SAVE_JSON=true

# Production-only (ignored in development)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
